<section class="hero-benefits">
    <div class="container">
        <h2>{{ section.settings.heading }}</h2>

        <div class="benefits-grid">
            <div class="benefit-card">
                <img src="{{ 'feat-icon-1.png' | asset_url }}" alt="{{ section.settings.benefit_1_title }}">
                <div class="benefit-content">
                    <h3>{{ section.settings.benefit_1_title }}</h3>
                    <p>{{ section.settings.benefit_1_text }}</p>
                </div>
            </div>

            <div class="center-image">
                <img src="{{ 'section-1-img.png' | asset_url }}" alt="Product">
            </div>

            <div class="benefit-card">
                <img src="{{ 'feat-icon-2.png' | asset_url }}" alt="{{ section.settings.benefit_2_title }}">
                <div class="benefit-content">
                    <h3>{{ section.settings.benefit_2_title }}</h3>
                    <p>{{ section.settings.benefit_2_text }}</p>
                </div>
            </div>

            <div class="benefit-card">
                <img src="{{ 'feat-icon-3.png' | asset_url }}" alt="{{ section.settings.benefit_3_title }}">
                <div class="benefit-content">
                    <h3>{{ section.settings.benefit_3_title }}</h3>
                    <p>{{ section.settings.benefit_3_text }}</p>
                </div>
            </div>

            <div class="benefit-card">
                <img src="{{ 'feat-icon-4.png' | asset_url }}" alt="{{ section.settings.benefit_4_title }}">
                <div class="benefit-content">
                    <h3>{{ section.settings.benefit_4_title }}</h3>
                    <p>{{ section.settings.benefit_4_text }}</p>
                </div>
            </div>
        </div>

        <button class="btn-primary btn-full-width">{{ section.settings.cta_text }}</button>

        <div class="trust-badges">
            <div class="guarantee-row">
                <img src="{{ 'shield-check.svg' | asset_url }}" alt="Guarantee" class="shield-icon">
                <span>{{ section.settings.guarantee_text }}</span>
            </div>
            <div class="payment-row">
                <div class="payment-icons">
                    {% for type in shop.enabled_payment_types %}
                        {{ type | payment_type_svg_tag }}
                    {% endfor %}
                </div>
            </div>
        </div>
    </div>
</section>

<style>
.hero-benefits {
    text-align: center;
    padding: var(--spacing-xl) var(--spacing-sm);
}

.hero-benefits h2 {
    font-size: var(--font-size-section);
    font-weight: 600;
    margin-bottom: var(--spacing-lg);
    width: 540px;
    margin: 0 auto;
    color: #1a1a1a;
}

.benefits-grid {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    grid-template-rows: auto auto;
    gap: var(--spacing-lg);
    max-width: 1200px;
    margin: var(--spacing-lg) auto;
    align-items: center;
}

.center-image {
    grid-row: 1 / 3;
    grid-column: 2;
}

.center-image img {
    max-width: 300px;
    border-radius: 50%;
}

.benefit-card {
    display: flex;
    align-items: flex-start;
    gap: var(--spacing-sm);
    text-align: left;
}

.benefit-card img {
    width: 60px;
    height: 60px;
    flex-shrink: 0;
    border-radius: 50%;
}

.benefit-content h3 {
    font-size: var(--font-size-feature);
    font-weight: 600;
    margin-bottom: var(--spacing-xs);
    color: #1a1a1a;
}

.benefit-content p {
    font-size: var(--font-size-body);
    font-weight: 400;
    color: var(--color-text);
    line-height: 1.6;
    margin-bottom: 0;
}

.hero-benefits .btn-primary {
    margin-top: var(--spacing-md);
}

.btn-full-width {
    width: 100%;
    max-width: 600px;
}

.trust-badges {
    margin-top: var(--spacing-md);
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    gap: var(--spacing-lg);
    flex-wrap: wrap;
}

.guarantee-row {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 14px;
    color: var(--color-text);
}

.guarantee-row .shield-icon {
    width: 16px;
    height: 16px;
    border-radius: 0;
}

.payment-row {
    display: flex;
    align-items: center;
    gap: 8px;
}

.payment-label {
    color: var(--color-text);
    font-size: 14px;
    font-weight: 400;
}

.payment-icons {
    display: flex;
    align-items: center;
    gap: 8px;
}

.payment-icons svg {
    height: 24px;
    width: auto;
}

@media (max-width: 768px) {
    .benefits-grid {
        grid-template-columns: 1fr;
        grid-template-rows: auto;
        gap: var(--spacing-md);
    }

    .center-image {
        grid-row: auto;
        grid-column: auto;
    }

    .center-image img {
        max-width: 250px;
    }
}
</style>

{% schema %}
{
