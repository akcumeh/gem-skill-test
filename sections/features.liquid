<section class="hero-benefits">
    <div class="container">
        <h2>{{ section.settings.heading }}</h2>

        <div class="benefits-grid">
            <div class="benefit-card">
                <img src="{{ 'feat-icon-1.png' | asset_url }}" alt="{{ section.settings.benefit_1_title }}">
                <div class="benefit-content">
                    <h3>{{ section.settings.benefit_1_title }}</h3>
                    <p>{{ section.settings.benefit_1_text }}</p>
                </div>
            </div>

            <div class="center-image">
                <div class="before-after-slider" data-before-after>
                    <div class="before-image">
                        <img src="{{ 'before.png' | asset_url }}" alt="Before">
                    </div>
                    <div class="after-image">
                        <img src="{{ 'after.png' | asset_url }}" alt="After">
                    </div>
                    <input type="range" min="0" max="100" value="50" class="slider-handle" data-slider-handle>
                    <div class="slider-line" data-slider-line>
                        <div class="slider-button"></div>
                    </div>
                </div>
            </div>

            <div class="benefit-card">
                <img src="{{ 'feat-icon-2.png' | asset_url }}" alt="{{ section.settings.benefit_2_title }}">
                <div class="benefit-content">
                    <h3>{{ section.settings.benefit_2_title }}</h3>
                    <p>{{ section.settings.benefit_2_text }}</p>
                </div>
            </div>

            <div class="benefit-card">
                <img src="{{ 'feat-icon-3.png' | asset_url }}" alt="{{ section.settings.benefit_3_title }}">
                <div class="benefit-content">
                    <h3>{{ section.settings.benefit_3_title }}</h3>
                    <p>{{ section.settings.benefit_3_text }}</p>
                </div>
            </div>

            <div class="benefit-card">
                <img src="{{ 'feat-icon-4.png' | asset_url }}" alt="{{ section.settings.benefit_4_title }}">
                <div class="benefit-content">
                    <h3>{{ section.settings.benefit_4_title }}</h3>
                    <p>{{ section.settings.benefit_4_text }}</p>
                </div>
            </div>
        </div>

        <button class="btn-primary btn-full-width">{{ section.settings.cta_text }}</button>

        <div class="trust-badges">
            <div class="guarantee-row">
                <img src="{{ 'shield-check.svg' | asset_url }}" alt="Guarantee" class="shield-icon">
                <span>{{ section.settings.guarantee_text }}</span>
            </div>
            <div class="payment-row">
                <div class="payment-icons">
                    {% for type in shop.enabled_payment_types %}
                        {{ type | payment_type_svg_tag }}
                    {% endfor %}
                </div>
            </div>
        </div>
    </div>
</section>

<style>
.hero-benefits {
    text-align: center;
    padding: var(--spacing-xl) var(--spacing-sm);
}

.hero-benefits h2 {
    font-size: var(--font-size-section);
    font-weight: 600;
    margin-bottom: var(--spacing-lg);
    width: 540px;
    margin: 0 auto;
    color: #1a1a1a;
}

.benefits-grid {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    grid-template-rows: auto auto;
    gap: var(--spacing-lg);
    max-width: 1200px;
    margin: var(--spacing-lg) auto;
    align-items: center;
}

.center-image {
    grid-row: 1 / 3;
    grid-column: 2;
}

.center-image img {
    max-width: 300px;
    border-radius: 50%;
}

.before-after-slider {
    position: relative;
    width: 300px;
    height: 300px;
    margin: 0 auto;
}

.before-image,
.after-image {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
}

.before-image {
    position: relative;
}

.before-image img,
.after-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    border-radius: 0;
}

.after-image {
    clip-path: inset(0 0 0 50%);
}

.slider-handle {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    opacity: 0;
    cursor: ew-resize;
    z-index: 3;
}

.slider-line {
    position: absolute;
    top: 0;
    left: 50%;
    width: 2px;
    height: 100%;
    background: var(--color-primary);
    transform: translateX(-50%);
    pointer-events: none;
    z-index: 2;
}

.slider-button {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 40px;
    height: 40px;
    background: white;
    border-radius: 50%;
    transform: translate(-50%, -50%);
    box-shadow: 0 2px 8px rgba(0,0,0,0.2);
}

.slider-button::before,
.slider-button::after {
    content: '';
    position: absolute;
    width: 0;
    height: 0;
    border-style: solid;
    top: 50%;
    transform: translateY(-50%);
}

.slider-button::before {
    left: 8px;
    border-width: 6px 8px 6px 0;
    border-color: transparent var(--color-primary) transparent transparent;
}

.slider-button::after {
    right: 8px;
    border-width: 6px 0 6px 8px;
    border-color: transparent transparent transparent var(--color-primary);
}

.benefit-card {
    display: flex;
    align-items: flex-start;
    gap: var(--spacing-sm);
    text-align: left;
}

.benefit-card img {
    width: 60px;
    height: 60px;
    flex-shrink: 0;
    border-radius: 50%;
}

.benefit-content h3 {
    font-size: var(--font-size-feature);
    font-weight: 600;
    margin-bottom: var(--spacing-xs);
    color: #1a1a1a;
}

.benefit-content p {
    font-size: var(--font-size-body);
    font-weight: 400;
    color: var(--color-text);
    line-height: 1.6;
    margin-bottom: 0;
}

.hero-benefits .btn-primary {
    margin-top: var(--spacing-md);
}

.btn-full-width {
    width: 100%;
    max-width: 600px;
}

.trust-badges {
    margin-top: var(--spacing-md);
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    gap: var(--spacing-lg);
    flex-wrap: wrap;
}

.guarantee-row {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 14px;
    color: var(--color-text);
}

.guarantee-row .shield-icon {
    width: 16px;
    height: 16px;
    border-radius: 0;
}

.payment-row {
    display: flex;
    align-items: center;
    gap: 8px;
}

.payment-label {
    color: var(--color-text);
    font-size: 14px;
    font-weight: 400;
}

.payment-icons {
    display: flex;
    align-items: center;
    gap: 8px;
}

.payment-icons svg {
    height: 24px;
    width: auto;
}

@media (max-width: 640px) {
    .hero-benefits h2 {
        width: 100%;
        margin-bottom: var(--spacing-lg);
    }

    .benefits-grid {
        grid-template-columns: 1fr;
        grid-template-rows: auto;
        gap: var(--spacing-md);
        display: flex;
        flex-direction: column;
    }

    .center-image {
        order: 1;
        margin: 0 auto;
    }

    .benefit-card:nth-of-type(1) {
        order: 2;
    }

    .benefit-card:nth-of-type(2) {
        order: 3;
    }

    .benefit-card:nth-of-type(3) {
        order: 4;
    }

    .benefit-card:nth-of-type(4) {
        order: 5;
    }

    .benefit-card:nth-of-type(5) {
        order: 6;
    }

    .before-after-slider {
        width: 300px;
        height: auto;
        margin: 0 auto;
    }

    .benefit-card {
        text-align: center;
        flex-direction: column;
        align-items: center;
    }

    .benefit-content {
        text-align: center;
    }
}
</style>

