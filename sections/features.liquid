            "default": "Made Fresh"
        },
        {
            "type": "textarea",
            "id": "benefit_2_text",
            "label": "Benefit 2 Text",
            "default": "We prioritize maintaining the integrity of whole foods and nutrition."
        },
        {
            "type": "image_picker",
            "id": "icon_3",
            "label": "Icon 3"
        },
        {
            "type": "text",
            "id": "benefit_3_title",
            "label": "Benefit 3 Title",
            "default": "Premium Ingredient"
        },
        {
            "type": "textarea",
            "id": "benefit_3_text",
